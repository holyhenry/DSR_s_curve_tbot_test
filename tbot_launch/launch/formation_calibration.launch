<launch>
  <!-- Launch this file ON ONE ROBOT, alongside its existing base bringup only. -->
  <!-- The robot's follower_id picks a fixed formation slot. No central controller. -->
  <arg name="follower_id" default="0" /> <!-- required: 1,2,3 for platoon; 1,2 for V -->
  <arg name="formation_type" default="platoon" />
  <arg name="dry_run" default="true" />

  <!-- Actual mocap pose topics, verified for bot162; others use VRPN naming convention. -->
  <arg name="f1_mocap" default="/vrpn_client_node/bot162/pose" />
  <arg name="f2_mocap" default="/vrpn_client_node/bot149/pose" />
  <arg name="f3_mocap" default="/vrpn_client_node/bot165/pose" />
  <arg name="pose_topic" default="$(eval arg('f1_mocap') if int(arg('follower_id')) == 1 else (arg('f2_mocap') if int(arg('follower_id')) == 2 else arg('f3_mocap')))" />

  <!-- Inferred from follower_id; verify against actual ROS namespace before live operation. -->
  <arg name="cmd_topic" default="$(eval '/tbot162/cmd_vel' if int(arg('follower_id')) == 1 else ('/tbot149/cmd_vel' if int(arg('follower_id')) == 2 else '/tbot165/cmd_vel'))" />

  <!-- Reference leader pose must be identical in every robot's launch. -->
  <arg name="leader_x" default="$(eval '2.5' if arg('formation_type') == 'v_formation' else '-0.5')" />
  <arg name="leader_y" default="0.8" />
  <arg name="leader_yaw" default="-3.141592653589793" />
  <arg name="spacing" default="0.25" />
  <arg name="arrow_a" default="0.25" />
  <arg name="arrow_b" default="0.15" />

  <!-- Pose transform: mocap axes to experiment/simulation global axes.
       Per tf.pdf: mocap origin is (-0.355,-0.722) in experiment frame.
       Coordinate conversion rotates +90 degrees (axes appear clockwise). -->
  <arg name="tf_horizontal_displacement" default="0.355" />
  <arg name="tf_vertical_displacement" default="0.722" />
  <arg name="tf_rotation_deg" default="90.0" />

  <!-- F1 live trial converged with 20 mm and 3 degrees. -->
  <arg name="position_tolerance" default="0.02" />
  <arg name="yaw_tolerance_deg" default="3.0" />
  <arg name="max_linear_speed" default="0.08" />
  <arg name="max_angular_speed" default="0.5" />
  <arg name="kp_linear" default="0.8" />
  <arg name="kp_angular" default="1.5" />
  <arg name="turn_in_place_deg" default="30.0" />
  <arg name="control_rate" default="20.0" />
  <arg name="mocap_timeout" default="0.5" />
  <arg name="calibration_timeout" default="120.0" />
  <arg name="settle_time" default="0.5" />
  <arg name="mocap_frame" default="" />

  <node pkg="tbot_launch" type="formation_calibration.py"
        name="formation_calibration" output="screen" required="false">
    <param name="follower_id" value="$(arg follower_id)" />
    <param name="formation_type" value="$(arg formation_type)" />
    <param name="dry_run" value="$(arg dry_run)" />
    <param name="pose_topic" value="$(arg pose_topic)" />
    <param name="cmd_topic" value="$(arg cmd_topic)" />
    <param name="tf_horizontal_displacement" value="$(arg tf_horizontal_displacement)" />
    <param name="tf_vertical_displacement" value="$(arg tf_vertical_displacement)" />
    <param name="tf_rotation_deg" value="$(arg tf_rotation_deg)" />
    <param name="leader_x" value="$(arg leader_x)" />
    <param name="leader_y" value="$(arg leader_y)" />
    <param name="leader_yaw" value="$(arg leader_yaw)" />
    <param name="spacing" value="$(arg spacing)" />
    <param name="arrow_a" value="$(arg arrow_a)" />
    <param name="arrow_b" value="$(arg arrow_b)" />
    <param name="position_tolerance" value="$(arg position_tolerance)" />
    <param name="yaw_tolerance_deg" value="$(arg yaw_tolerance_deg)" />
    <param name="max_linear_speed" value="$(arg max_linear_speed)" />
    <param name="max_angular_speed" value="$(arg max_angular_speed)" />
    <param name="kp_linear" value="$(arg kp_linear)" />
    <param name="kp_angular" value="$(arg kp_angular)" />
    <param name="turn_in_place_deg" value="$(arg turn_in_place_deg)" />
    <param name="control_rate" value="$(arg control_rate)" />
    <param name="mocap_timeout" value="$(arg mocap_timeout)" />
    <param name="calibration_timeout" value="$(arg calibration_timeout)" />
    <param name="settle_time" value="$(arg settle_time)" />
    <param name="mocap_frame" value="$(arg mocap_frame)" />
  </node>
</launch>
