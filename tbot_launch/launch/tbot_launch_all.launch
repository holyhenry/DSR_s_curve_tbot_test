<?xml version="1.0"?>

<launch>

	<!-- <arg name="env"       default="/opt/ros/noetic/env_henry.sh"/> -->
	<arg name="env"            default="/opt/ros/noetic/env_alien.sh"/>
	<arg name="use_Bezier"     default="True"/>
	<arg name="ues_DSR"        default="True"/>
	<arg name="spacing"        default="0.45"/>
	<arg name="alpha"          default="0.3"/>
	<arg name="beta1"          default="0.5"/>
	<arg name="beta2"          default="0.5"/>
	<arg name="lowpass_gain"   default="0.1"/> 
	<arg name="reinforce_scal" default="0.95"/> 

    <!-- tbot165 -->
	<group ns="tbot165">
		<machine
					name="bot165"
					address="192.168.0.165"
					env-loader="$(arg env)"
					default="true"
					user="ubuntu"
					password="turtlebot"
		/>
		<node machine="bot165" pkg="rosserial_python" type="serial_node.py" name="turtlebot3_core_165" output="screen">
			<param name="port" value="/dev/ttyACM0"/>
			<param name="baud" value="115200"/>
		</node>
	</group>

	<!-- tbot162 -->
	<group ns="tbot162">
		<machine
					name="bot162"
					address="192.168.0.162"
					env-loader="$(arg env)"
					default="true"
					user="ubuntu"
					password="turtlebot"
		/>
		<node machine="bot162" pkg="rosserial_python" type="serial_node.py" name="turtlebot3_core_162" output="screen">
			<param name="port" value="/dev/ttyACM0"/>
			<param name="baud" value="115200"/>
		</node>

		<node machine="bot162" pkg="camera_multi_tag" name="image_publisher" type="image_publisher.py" output="screen" />
		<node machine="bot162" pkg="camera_multi_tag" name="cam_multi_tag_node" type="camera_multi_tag" output="screen" />
		
		<node machine="bot162" pkg="pd_tracking_xy" name="pd_tracking_xy" type="pd_tracking_xy.py" output="screen">
			<param name="follower_indx"   value="1"/>
			<param name="use_Bezier"      value="$(arg use_Bezier)"/>
			<param name="ues_DSR"         value="$(arg ues_DSR)"/>
			<param name="spacing"         value="$(arg spacing)"/>
			<param name="alpha"           value="$(arg alpha)"/>
			<param name="beta1"           value="$(arg beta1)"/>
			<param name="beta2"           value="$(arg beta2)"/>
			<param name="lowpass_gain"    value="$(arg lowpass_gain)"/>
			<param name="reinforce_scal"  value="$(arg reinforce_scal)"/>
		</node>
	</group>

	<!-- tbot149 -->
	<group ns="tbot149">
		<machine
					name="bot149"
					address="192.168.0.149"
					env-loader="$(arg env)"
					default="true"
					user="ubuntu"
					password="turtlebot"
		/>
		<node machine="bot149" pkg="rosserial_python" type="serial_node.py" name="turtlebot3_core_149" output="screen">
			<param name="port" value="/dev/ttyACM0"/>
			<param name="baud" value="115200"/>
		</node>

		<node machine="bot149" pkg="camera_multi_tag" name="image_publisher" type="image_publisher.py" output="screen" />
		<node machine="bot149" pkg="camera_multi_tag" name="cam_multi_tag_node" type="camera_multi_tag" output="screen" />
		
		<node machine="bot149" pkg="pd_tracking_xy" name="pd_tracking_xy" type="pd_tracking_xy.py" output="screen">
			<param name="follower_indx"   value="0"/>
			<param name="use_Bezier"      value="$(arg use_Bezier)"/>
			<param name="ues_DSR"         value="$(arg ues_DSR)"/>
			<param name="spacing"         value="$(arg spacing)"/>
			<param name="alpha"           value="$(arg alpha)"/>
			<param name="beta1"           value="$(arg beta1)"/>
			<param name="beta2"           value="$(arg beta2)"/>
			<param name="lowpass_gain"    value="$(arg lowpass_gain)"/>
			<param name="reinforce_scal"  value="$(arg reinforce_scal)"/>
		</node>
	</group>
	
	<!-- tbot205 -->
	<group ns="tbot205">
		<machine
					name="bot205"
					address="192.168.0.205"
					env-loader="$(arg env)"
					default="true"
					user="ubuntu"
					password="turtlebot"
		/>
		<node machine="bot205" pkg="rosserial_python" type="serial_node.py" name="turtlebot3_core_205" output="screen">
			<param name="port" value="/dev/ttyACM0"/>
			<param name="baud" value="115200"/>
		</node>

		<node machine="bot205" pkg="camera_multi_tag" name="image_publisher" type="image_publisher.py" output="screen" />
		<node machine="bot205" pkg="camera_multi_tag" name="cam_multi_tag_node" type="camera_multi_tag" output="screen" />
		
		<node machine="bot205" pkg="pd_tracking_xy" name="pd_tracking_xy" type="pd_tracking_xy.py" output="screen">
			<param name="follower_indx"   value="2"/>
			<param name="use_Bezier"      value="$(arg use_Bezier)"/>
			<param name="ues_DSR"         value="$(arg ues_DSR)"/>
			<param name="spacing"         value="$(arg spacing)"/>
			<param name="alpha"           value="$(arg alpha)"/>
			<param name="beta1"           value="$(arg beta1)"/>
			<param name="beta2"           value="$(arg beta2)"/>
			<param name="lowpass_gain"    value="$(arg lowpass_gain)"/>
			<param name="reinforce_scal"  value="$(arg reinforce_scal)"/>
		</node>
	</group>

</launch>
