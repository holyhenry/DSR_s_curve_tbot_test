<?xml version="1.0"?>

<launch>
	<machine
                name="bot165"
                address="192.168.0.165"
                env-loader="/opt/ros/noetic/env_henry.sh"
                default="true"
                user="ubuntu"
                password="turtlebot"
	/>
	<group ns="tbot165">
		<node machine="bot165" pkg="rosserial_python" type="serial_node.py" name="turtlebot3_core_165" output="screen">
			<param name="port" value="/dev/ttyACM0"/>
			<param name="baud" value="115200"/>
		</node>
	</group>

	<machine
                name="bot199"
                address="192.168.0.199"
                env-loader="/opt/ros/noetic/env_henry.sh"
                default="true"
                user="ubuntu"
                password="turtlebot"
	/>
	<group ns="tbot199">
		<node machine="bot199" pkg="rosserial_python" type="serial_node.py" name="turtlebot3_core_199" output="screen">
			<param name="port" value="/dev/ttyACM0"/>
			<param name="baud" value="115200"/>
		</node>

		<node machine="bot199" pkg="camera_multi_tag" name="image_publisher" type="image_publisher.py" output="screen" />
		<node machine="bot199" pkg="camera_multi_tag" name="cam_multi_tag_node" type="camera_multi_tag" output="screen" />
		
		<node machine="bot199" pkg="pd_tracking_xy" name="pd_tracking_xy" type="pd_tracking_xy.py" output="screen">
			<param name="spacing" value="0.5"/>
			<param name="alpha"   value="0.3"/>
			<param name="bate"    value="0.5"/>
		</node>
	</group>

</launch>
