<launch>

	<arg name="use_Bezier"     default="True"/>
	<arg name="ues_DSR"        default="False"/>
	<arg name="spacing"        default="0.25"/>
	<arg name="alpha"          default="0.3"/>
	<arg name="beta1"          default="0.3"/>
	<arg name="beta2"          default="0.85"/>
	<arg name="lowpass_gain"   default="1.0"/> 
	<arg name="reinforce_scal" default="1.0"/> 

