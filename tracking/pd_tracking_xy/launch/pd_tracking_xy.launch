<launch>
  <node pkg="pd_tracking_xy" name="pd_tracking_xy" type="pd_tracking_xy.py" output="screen">
			<param name="follower_indx" value="0"/>
			<param name="ues_DSR" value="True"/>
			<param name="spacing" value="0.5"/>
			<param name="alpha"   value="0.3"/>
			<param name="beta"    value="0.5"/>
  </node>
</launch>