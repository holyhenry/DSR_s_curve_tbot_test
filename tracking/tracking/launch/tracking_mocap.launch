<launch>
  <!-- Run on one follower with its base and mocap already running (ROS 1).
       bot162: follower_indx:=0; bot149: follower_indx:=1.
       Commands go to this follower's relative cmd_vel topic only. -->
  <arg name="follower_indx"/>
  <arg name="leader_pose_topic" default="/bot205/pose"/>
  <arg name="follower_pose_topic" default="$(eval '/bot162/pose' if int(arg('follower_indx')) == 0 else '/bot149/pose')"/>
  <!-- Validated heading corrections for leader and follower rigid bodies. -->
  <arg name="leader_yaw_offset" default="3.141592653589793"/>
  <arg name="follower_yaw_offset" default="0.0"/>
  <!-- Both PoseStamped frames must match. Set this to require a specific frame. -->
  <arg name="mocap_frame" default=""/>
  <arg name="mocap_timeout" default="0.5"/>
  <!-- Symmetric linear command cap in m/s; zero preserves controller output. -->
  <arg name="mocap_max_linear_speed" default="0.0"/>
  <arg name="mocap_pair_slop" default="0.05"/>
  <arg name="odom_timeout" default="0.5"/>
  <!-- Stop on contradictory targets; distances are in follower-local meters. -->
  <arg name="direction_interlock" default="true"/>
  <arg name="interlock_los_ahead" default="0.10"/>
  <arg name="interlock_dsr_behind" default="0.10"/>
  <arg name="mocap_lsq_buffer" default="7"/>

  <!-- Same parameters as tracking.launch. -->
  <arg name="ctrl_mode" default="DSR"/>
  <arg name="ang_ctrl_mode" default="LOS"/>
  <arg name="alpha" default="0.3"/>
  <arg name="alpha_angle" default="3.0"/>
  <arg name="beta1" default="0.8"/>
  <arg name="beta2" default="0.94"/>
  <arg name="tau" default="0.04"/>
  <arg name="spacing" default="0.35"/>
  <arg name="arrow_a" default="0.25"/>
  <arg name="arrow_b" default="0.15"/>
  <!-- Motion requires explicitly setting diagnostic_only:=false. -->
  <arg name="diagnostic_only" default="true"/>
  <arg name="enable_lighting" default="true"/>
  <arg name="brightness" default="0.02"/>

  <include file="$(find tracking)/launch/odom_cov.launch"/>

  <node name="tracking_mocap_node" pkg="tracking" type="tracking_mocap_node" output="screen">
    <param name="formation_type" value="v_formation"/>
    <param name="follower_indx" value="$(arg follower_indx)"/>
    <param name="leader_pose_topic" value="$(arg leader_pose_topic)"/>
    <param name="follower_pose_topic" value="$(arg follower_pose_topic)"/>
    <param name="leader_yaw_offset" value="$(arg leader_yaw_offset)"/>
    <param name="follower_yaw_offset" value="$(arg follower_yaw_offset)"/>
    <param name="mocap_frame" value="$(arg mocap_frame)"/>
    <param name="mocap_timeout" value="$(arg mocap_timeout)"/>
    <param name="mocap_max_linear_speed" value="$(arg mocap_max_linear_speed)"/>
    <param name="mocap_pair_slop" value="$(arg mocap_pair_slop)"/>
    <param name="odom_timeout" value="$(arg odom_timeout)"/>
    <param name="direction_interlock" value="$(arg direction_interlock)"/>
    <param name="interlock_los_ahead" value="$(arg interlock_los_ahead)"/>
    <param name="interlock_dsr_behind" value="$(arg interlock_dsr_behind)"/>
    <param name="mocap_lsq_buffer" value="$(arg mocap_lsq_buffer)" type="int"/>
    <param name="ctrl_mode" value="$(arg ctrl_mode)"/>
    <param name="ang_ctrl_mode" value="$(arg ang_ctrl_mode)"/>
    <param name="alpha" value="$(arg alpha)"/>
    <param name="alpha_angle" value="$(arg alpha_angle)"/>
    <param name="beta1" value="$(arg beta1)"/>
    <param name="beta2" value="$(arg beta2)"/>
    <param name="tau" value="$(arg tau)"/>
    <param name="spacing" value="$(arg spacing)"/>
    <param name="arrow_a" value="$(arg arrow_a)"/>
    <param name="arrow_b" value="$(arg arrow_b)"/>
    <param name="diagnostic_only" value="$(arg diagnostic_only)"/>
  </node>
  <!-- Existing NeoPixel driver consumes controller_log_info in this namespace. -->
  <include if="$(arg enable_lighting)" file="$(find lighting)/launch/lighting.launch">
    <arg name="brightness" value="$(arg brightness)"/>
  </include>
</launch>
